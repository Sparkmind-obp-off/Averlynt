# Build output (generated by `npm run build`)
dist/

# Dependencies (the site itself has none; tooling may be installed ad hoc)
node_modules/

# Cloudflare / Wrangler local state
.wrangler/

# Secrets and local environment — never commit
.env
.env.*
.dev.vars
*.pem

# Process manager, logs, QA artefacts
.pm2/
logs/
*.log
qa-artifacts/

# Archives and editor noise
*.tar.gz
*.zip
*.bak
.DS_Store
